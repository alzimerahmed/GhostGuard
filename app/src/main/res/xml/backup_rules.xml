<?xml version="1.0" encoding="utf-8"?><!--
  Privacy-first backup rules (API < 31).
  DNS query logs (Room DB) and filesDir (MITM CA private key, filter caches)
  must never leave the device. Only non-sensitive preferences are backed up.
-->
<full-backup-content>
    <exclude domain="database" path="." />
    <exclude domain="file" path="." />
    <exclude domain="sharedpref" path="." />
    <exclude domain="external" path="." />
</full-backup-content>
