<?xml version="1.0" encoding="utf-8"?><!--
  Privacy-first backup rules (API < 31).
  No app data is backed up: DNS query logs (Room DB), filesDir
  (MITM CA private key, filter caches), and preferences never leave
  the device. The app is fully functional after a restore without
  any backed-up state.
-->
<full-backup-content>
    <exclude domain="root" path="." />
    <exclude domain="database" path="." />
    <exclude domain="file" path="." />
    <exclude domain="sharedpref" path="." />
    <exclude domain="external" path="." />
</full-backup-content>
