<?xml version="1.0" encoding="utf-8"?><!--
  Privacy-first data extraction rules (API 31+).
  DNS query logs (Room DB) and filesDir (MITM CA private key, filter caches)
  must never leave the device via cloud backup or device transfer.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="database" path="." />
        <exclude domain="file" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="database" path="." />
        <exclude domain="file" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </device-transfer>
</data-extraction-rules>
